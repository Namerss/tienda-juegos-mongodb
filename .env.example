# Copiá este archivo como .env (no se sube a git) y completá los valores.
MONGO_HOSTS=localhost:27017,localhost:27018
MONGO_REPLICA_SET=rs0
MONGO_DB=tiendaJuegos

# Usuario con el que corren los scripts 01-03 (vacío = sin autenticación, Pasos 1 y 2)
MONGO_USER=
MONGO_PASS=

# Usados por 04_crear_usuarios.py y 05_verificar_seguridad.py
ADMIN_USER=admin
ADMIN_PASS=
APP_USER=tienda_app
APP_PASS=
